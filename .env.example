# Copy to .env and fill in. .env is git-ignored; CI reads these from secrets.

BASE_URL=https://app.lucidlink.com

# The app's own api/v2, used by API-backed cleanup (WORKSPACE_STATE=api).
# Optional; this is the default.
API_URL=https://api.lucidlink.com/api/v2

# Workspace under test. The id is the UUID in the dashboard URL:
# https://app.lucidlink.com/workspaces/<WORKSPACE_ID>
WORKSPACE_ID=
WORKSPACE_NAME=

# Must hold Owner/Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# A second admin with their own workspace, used only by seat-limit tests (they
# fill it to capacity). Create and verify once by hand; nothing else may use it.
SEAT_ADMIN_EMAIL=
SEAT_ADMIN_PASSWORD=
SEAT_WORKSPACE_ID=
SEAT_WORKSPACE_NAME=

# Registered, email-verified accounts used by the accept flows: one per parallel
# worker, comma separated. An unverified account cannot log in, so each of these
# must have been created and verified once by hand.
# The pool size caps useful parallelism — see PW_WORKERS below.
INVITEE_EMAILS=
INVITEE_PASSWORD=

# Addresses generated for invite-only tests are built from this prefix, and the
# cleanup sweep only ever touches rows that match it. Keep it distinctive: it is
# the boundary that protects real members on a shared workspace.
TEST_EMAIL_PREFIX=svet_ll_
TEST_EMAIL_DOMAIN=mailinator.com

# A group that already exists in the workspace (besides the implicit Everyone);
# the group-assignment test invites into it. Defaults to "2nd division".
INVITE_GROUP_NAME=

# How cleanup and the sweep run: `api` (default, fast) uses the app's own api/v2
# with the admin's token; `ui` drives the Members page. Inviting is UI either way.
# Fall back to `ui` if the undocumented API changes.
WORKSPACE_STATE=api

# Bounded by workspace seats, not CPU: the trial plan caps the workspace at 10
# members and every worker holds one invitee identity.
PW_WORKERS=2
